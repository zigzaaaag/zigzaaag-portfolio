# Only portfolio source, media and maintenance files are published.
/*
!/index.html
!/about.html
!/project.html
!/styles.css
!/portfolio.css
!/script.js
!/portfolio.js
!/data/
!/server.cjs
!/package.json
!/tools/
!/tests/
